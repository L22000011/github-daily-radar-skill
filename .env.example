# Required: DeepSeek API key for 7-point scriptwriting (deepseek-chat)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: GitHub personal access token fallback when gh CLI is unavailable
# GITHUB_TOKEN=your_github_token_here

# Optional: Alibaba DashScope API key when using --tts dashscope
# DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Optional: Explicit ffmpeg / ffprobe binary paths (defaults to system PATH or ./tools/ffmpeg/)
# FFMPEG_EXE=/path/to/ffmpeg
# FFPROBE_EXE=/path/to/ffprobe

# Optional: Custom output root and snapshot history directory (defaults to ./output)
# GITHUB_RADAR_OUT_ROOT=./output
# GITHUB_RADAR_HISTORY_DIR=./output/history

# Optional: ASS subtitle font family override (auto-selects Microsoft YaHei / PingFang SC / Noto Sans CJK SC)
# GITHUB_RADAR_ASS_FONT=Microsoft YaHei

# Optional: Force Playwright browser channel (e.g. chrome, msedge; leave blank for auto fallback)
# PLAYWRIGHT_CHANNEL=

# Optional: Local FastAPI server bind settings for n8n automation
# GITHUB_RADAR_HOST=0.0.0.0
# GITHUB_RADAR_PORT=8010
